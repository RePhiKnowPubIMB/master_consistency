{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "server/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "server/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "server/client/$1",
      "check": true
    },
    {
      "source": "/(.*)",
      "destination": "server/client/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/dashboard/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
